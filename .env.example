# TMDB v3 API key (the short "API Key (v3 auth)" string, not the v4 bearer token)
TMDB_API_KEY=

# OpenRouter API key — powers the AI Search catalog. Get one at
# https://openrouter.ai/keys. Leave blank to run without AI search.
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models. Defaults to OpenRouter's
# own free-model router (routes around whichever free model is congested,
# rather than pinning to one that might 429). Pin to a specific ":free" model
# (z-ai/glm-5.2:free, google/gemma-4-31b-it:free, ...) only if you want
# consistent model behavior over uptime.
OPENROUTER_MODEL=openrouter/free

# Prowlarr — powers the stream resource (torrent releases per title).
# Leave PROWLARR_API_KEY blank to run catalog-only, with no stream handler.
# Settings -> General -> API Key in Prowlarr's UI.
PROWLARR_URL=http://127.0.0.1:9696
PROWLARR_API_KEY=

# Real-Debrid API token — https://real-debrid.com/apitoken
# Optional. Enables the "Prowlarr — Debrid Cached" catalog and the RD stream
# option. NOTE: RD is only ever offered for torrents whose tracker announce
# carries no passkey, because handing a private tracker's passkey to RD would
# have RD's servers announce as you — a bannable offence on most such
# trackers. With only private indexers configured, this stays unused and
# every stream is served peer-to-peer instead.
REALDEBRID_TOKEN=

# Public origin Stremio should use for Real-Debrid resolve links. Must be
# reachable from the device running Stremio, so not the loopback address the
# server binds to. Only needed when REALDEBRID_TOKEN is set.
# PUBLIC_ORIGIN=http://129.154.250.79:7000

# Path where `rclone mount gdrive: <path>` is mounted on this VPS (see
# deploy/rclone-setup.md). Optional — the "Local" stream option (VPS
# download + seed for passkey-protected releases) simply does not appear
# if this path does not exist. Leave blank to use the default /mnt/gdrive.
GDRIVE_MOUNT_PATH=

# Optional. Google Cloud API key with the Drive API enabled (console.cloud.
# google.com -> APIs & Services -> Credentials). When set, mounted local-
# seed files stream directly from Google's servers instead of being proxied
# through this VPS. Leave blank to always proxy through the VPS.
GDRIVE_API_KEY=

# Optional overrides
HOST=127.0.0.1
PORT=7000
