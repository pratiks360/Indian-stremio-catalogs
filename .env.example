# TMDB v3 API key (the short "API Key (v3 auth)" string, not the v4 bearer token)
TMDB_API_KEY=

# OpenRouter API key — powers the AI Search catalog. Get one at
# https://openrouter.ai/keys. Leave blank to run without AI search.
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models. Defaults to a free one
# (":free" suffix = no cost, rate-limited instead of billed), e.g.
# z-ai/glm-5.2:free, google/gemma-4-31b-it:free, nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL=z-ai/glm-5.2:free

# Optional overrides
HOST=127.0.0.1
PORT=7000
