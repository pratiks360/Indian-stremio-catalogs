# TMDB v3 API key (the short "API Key (v3 auth)" string, not the v4 bearer token)
TMDB_API_KEY=

# OpenRouter API key — powers the AI Search catalog. Get one at
# https://openrouter.ai/keys. Leave blank to run without AI search.
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models. Defaults to OpenRouter's
# own free-model router (routes around whichever free model is congested,
# rather than pinning to one that might 429). Pin to a specific ":free" model
# (z-ai/glm-5.2:free, google/gemma-4-31b-it:free, ...) only if you want
# consistent model behavior over uptime.
OPENROUTER_MODEL=openrouter/free

# Optional overrides
HOST=127.0.0.1
PORT=7000
